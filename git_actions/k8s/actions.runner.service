[Unit]
Description=GitHub Actions self-hosted runner
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=actions
Group=actions
WorkingDirectory=/usr/local/share/application/actions-runner
EnvironmentFile=-/etc/actions-runner/runner.env
ExecStart=/usr/local/share/application/actions-runner/run.sh
Restart=always
RestartSec=5
KillMode=process

[Install]
WantedBy=multi-user.target
